  "request": {
    "inputs": [
      {
        "text": "जो आवश्यक कर्म करता है, लेकिन उसके फल पर आश्रित नहीं रहता, वही संन्यास और योग का अभ्यास कर रहा है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "अपने अनुशासन से स्वयं को ऊपर उठाओ। मन तुम्हारा सहायक बन सकता है; बिना संयम के वही तुम्हारे विरुद्ध काम कर सकता है। जैसे-जैसे वह सुख, दुख, प्रशंसा और तिरस्कार के वश में कम होता है, स्थिरता बढ़ती है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "उचित स्थान खोजो, स्थिर होकर बैठो और अपना ध्यान एकत्र करो। मन को मेरी ओर मुड़ने दो।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "बहुत अधिक या बहुत कम खाना, बहुत अधिक सोना या सदा जागते रहना, इस योग में सहायक नहीं है। भोजन, विश्राम, गतिविधि और प्रयास में संतुलन लाओ।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "स्थिर मन उस लौ की तरह है। अभ्यास से वह ऐसे आनंद को जान सकता है जो इंद्रियों पर निर्भर नहीं है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "जब-जब मन भटके, उसे वापस लाओ। दूसरे प्राणियों में स्वयं को और स्वयं में दूसरे प्राणियों को देखना सीखो। उनके सुख और दुख को उतनी ही गंभीरता से लो जितनी अपने सुख और दुख को लेते हो।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "लेकिन मन चंचल, बलवान और हठी है। उसे वश में करना हवा को थामने जैसा लगता है।",
        "voice_id": "HyhAfYGa3UDZpjb4Ci4k"
      },
      {
        "text": "यह कठिन है। फिर भी अभ्यास और आसक्ति को ढीला करने से इसे साधा जा सकता है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "उस व्यक्ति का क्या होता है जो श्रद्धा से शुरुआत करता है, लेकिन मार्ग पूरा नहीं कर पाता? क्या वह कहीं का नहीं रहता, खो जाता है?",
        "voice_id": "HyhAfYGa3UDZpjb4Ci4k"
      },
      {
        "text": "कल्याण की ओर किया गया कोई सच्चा प्रयास नष्ट नहीं होता। ऐसी साधना आगे के जन्मों तक फल देती है और साधक को फिर समझ की ओर खींच लाती है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "आगे बढ़ते रहो। योगियों में वह मुझे विशेष प्रिय है जिसका अंतर्मन मुझमें टिका है, जो श्रद्धा और प्रेम से मेरी उपासना करता है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      }
    ],

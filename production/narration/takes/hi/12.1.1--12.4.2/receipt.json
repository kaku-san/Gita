  "request": {
    "inputs": [
      {
        "text": "योग में कौन अधिक दृढ़ता से स्थित हैं: वे जो भक्ति से तुम्हारी उपासना करते हैं, या वे जो अविनाशी, अव्यक्त सत्य का चिंतन करते हैं?",
        "voice_id": "HyhAfYGa3UDZpjb4Ci4k"
      },
      {
        "text": "जिनका मन मुझमें टिका है और जो अटल श्रद्धा से उपासना करते हैं, वे योग में गहराई से जुड़े हैं। अव्यक्त का अनुसरण करने वाले भी लक्ष्य तक पहुँचते हैं, हालाँकि शरीरधारी प्राणियों के लिए वह मार्ग अधिक कठिन है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "जो मेरी भक्ति करते हैं, उनके लिए मैं जन्म-मरण के समुद्र से पार उतारने वाला बनता हूँ।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "अपना मन और बुद्धि मुझमें लगाओ। यदि अभी स्थिर नहीं रह सकते, तो लौटने का अभ्यास करो।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "यदि वह अभ्यास कठिन हो, तो मेरे लिए अपना कर्म करो। यदि इतना भी न कर सको, तो कर्मों के फल को अपना मानकर उनसे चिपकना छोड़ो और स्वयं को अनुशासित करो।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "उस त्याग में शांति है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "वह मुझे प्रिय है जो द्वेष नहीं करता, जो मित्रता और करुणा से भरा है, ममत्व और अपने बड़प्पन के भाव से मुक्त है, धैर्यवान और स्थिर है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "ऐसा व्यक्ति संसार को अनावश्यक रूप से अशांत नहीं करता, और न हर समय उसकी उथल-पुथल के वश में रहता है। भक्ति यह आकार देती है कि वह दूसरों के बीच कैसे जीता है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "मान और अपमान, प्रशंसा और निंदा, सुख और दुख में स्थिर रहना सीखो। यह आग्रह छोड़ दो कि सब कुछ तुम्हारे पक्ष में ही होना चाहिए।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "जो मुझे अपना परम लक्ष्य मानकर, श्रद्धा से इस जीवनदायी उपदेश का अनुसरण करते हैं, वे मुझे बहुत प्रिय हैं।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      }
    ],

  "request": {
    "inputs": [
      {
        "text": "कृष्ण, रथ को दोनों सेनाओं के बीच ले चलो। मैं देखना चाहता हूँ कि हमसे लड़ने कौन-कौन आया है।",
        "voice_id": "HyhAfYGa3UDZpjb4Ci4k"
      },
      {
        "text": "देखो, अर्जुन। ये हैं यहाँ इकट्ठे हुए कुरुवंशी।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "वहाँ उनके कुल के बुज़ुर्ग भीष्म खड़े थे। उनके पास ही उनके गुरु द्रोण थे। उनके आसपास अर्जुन ने रिश्तेदारों, मित्रों और उन लोगों को पहचाना जिन्हें वे वर्षों से जानते थे।",
        "voice_id": "JXjD3Apv5OBjfkhCa3tI"
      },
      {
        "text": "ये तो मेरे अपने लोग हैं।",
        "voice_id": "HyhAfYGa3UDZpjb4Ci4k"
      },
      {
        "text": "मेरे शरीर की शक्ति जा रही है। मुँह सूख रहा है। धनुष पर मेरा हाथ स्थिर नहीं रह पा रहा।",
        "voice_id": "HyhAfYGa3UDZpjb4Ci4k"
      },
      {
        "text": "मैं यहाँ लड़ने के लिए तैयार होकर आया था। अब जब देखता हूँ कि सामने कौन खड़े हैं, तो उन्हें मारने में मुझे कोई भलाई दिखाई नहीं देती।",
        "voice_id": "HyhAfYGa3UDZpjb4Ci4k"
      },
      {
        "text": "ऐसे जीते हुए राज्य का मैं क्या करूँगा? जिन लोगों के लिए हम उसे चाह सकते हैं, वे ही वहाँ अपने प्राण दाँव पर लगाकर खड़े हैं।",
        "voice_id": "HyhAfYGa3UDZpjb4Ci4k"
      },
      {
        "text": "हो सकता है वे लोभ में अंधे हो गए हों। क्या हमें भी उनके पीछे उसी गलत राह पर चलना चाहिए?",
        "voice_id": "HyhAfYGa3UDZpjb4Ci4k"
      },
      {
        "text": "जब परिवार नष्ट हो जाते हैं, तो पीछे बचे लोगों का क्या होता है? उनके जीवन, उनकी परंपराओं और दिवंगत जनों की स्मृति को कौन सँभालेगा?",
        "voice_id": "HyhAfYGa3UDZpjb4Ci4k"
      },
      {
        "text": "अर्जुन को सामने खड़ी मृत्यु का भय था, और उसके बाद जीवन के बिखर जाने का भी।",
        "voice_id": "JXjD3Apv5OBjfkhCa3tI"
      },
      {
        "text": "अगर मैं निहत्था रहूँ, विरोध भी न करूँ और वे मुझे मार डालें, तो वह भी इससे अच्छा लगता है।",
        "voice_id": "HyhAfYGa3UDZpjb4Ci4k"
      },
      {
        "text": "शोक से व्याकुल अर्जुन ने धनुष-बाण एक ओर रख दिए और बैठ गए।",
        "voice_id": "JXjD3Apv5OBjfkhCa3tI"
      }
    ],

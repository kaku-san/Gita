  "request": {
    "inputs": [
      {
        "text": "तुम संन्यास की प्रशंसा करते हो, और कर्म की भी। मैं किस मार्ग पर चलूँ?",
        "voice_id": "HyhAfYGa3UDZpjb4Ci4k"
      },
      {
        "text": "दोनों परम कल्याण तक पहुँचा सकते हैं, लेकिन यहाँ कर्म की साधना अधिक सुगम मार्ग है। सच्चा संन्यासी राग और द्वेष में नहीं डूबा रहता।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "ज्ञान और अनुशासित कर्म के लक्ष्य अलग होना ज़रूरी नहीं है। तुम जो जीवन जी रहे हो, उसी के भीतर पहचानो कि क्या छोड़ना है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "शरीर, मन और बुद्धि से कर्म करो, लेकिन उसे अपना मानकर उससे चिपकना छोड़ दो। कर्म ईश्वर को अर्पित करो। कमल के पत्ते पर जल की तरह, वह तुम्हें लिप्त किए बिना रह सकता है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "फल से चिपकना बाँधता है। उस पकड़ को छोड़ने से शांति आती है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "ज्ञानी एक विद्वान व्यक्ति, गाय, हाथी, कुत्ते और उस व्यक्ति को समदृष्टि से देखते हैं जिसे समाज बहिष्कृत मानता है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "उनके रूप और परिस्थितियाँ अलग हैं। ज्ञान इन भेदों में उलझकर नहीं रह जाता। जब समझ ईश्वर में टिकती है, तो खुश रहने का पूरा भार बाहरी सुखों को नहीं उठाना पड़ता।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "इंद्रियों के संपर्क से मिलने वाले सुखों की शुरुआत और अंत होता है। इच्छा और क्रोध के सेवक बने बिना उन्हें सहना सीखो।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "जो भीतर की ओर मुड़ते हैं, जो प्राणियों के कल्याण के लिए काम करते हैं, जो मुझे यज्ञ का भोक्ता, सभी लोकों का स्वामी और सभी प्राणियों का मित्र जानते हैं, वे शांति पाते हैं।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      }
    ],

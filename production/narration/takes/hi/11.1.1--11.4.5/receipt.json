  "request": {
    "inputs": [
      {
        "text": "तुमने जो सिखाया है, उससे मेरा बहुत-सा भ्रम दूर हुआ है। मैंने सुना है कि प्राणी कैसे उत्पन्न होते हैं और कैसे लीन हो जाते हैं। मैं तुम्हारा ऐश्वर्यपूर्ण रूप देखना चाहता हूँ। अगर तुम्हें लगता है कि मैं उसे सह सकूँगा, तो मुझे दिखाओ।",
        "voice_id": "HyhAfYGa3UDZpjb4Ci4k"
      },
      {
        "text": "मेरे अनगिनत रंगों और प्रकारों वाले रूपों को देखो। यहाँ एक साथ समाया हुआ पूरा संसार देखो, और वे अद्भुत दृश्य जिन्हें तुमने कभी नहीं देखा।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "तुम्हारी साधारण आँखें इस दर्शन को नहीं देख सकतीं। मैं तुम्हें दिव्य दृष्टि देता हूँ।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "तब कृष्ण ने विश्वरूप प्रकट किया। उसका तेज उस प्रकाश से कहीं परे था जिसे उस मैदान ने कभी जाना था।",
        "voice_id": "JXjD3Apv5OBjfkhCa3tI"
      },
      {
        "text": "मैं तुम्हारे भीतर प्राणियों और दैवी शक्तियों को देखता हूँ। तुम्हारा आदि, मध्य या अंत नहीं मिल रहा। तुम्हारा तेज हर दिशा में फैला है।",
        "voice_id": "HyhAfYGa3UDZpjb4Ci4k"
      },
      {
        "text": "और मैं अपने योद्धाओं को विनाश में प्रवेश करते देख रहा हूँ। भीष्म, द्रोण, धृतराष्ट्र के पुत्र, सब उसकी ओर दौड़ रहे हैं, जैसे नदियाँ समुद्र की ओर।",
        "voice_id": "HyhAfYGa3UDZpjb4Ci4k"
      },
      {
        "text": "मुझे शांति नहीं मिल रही। बताओ, इस भयानक रूप में तुम कौन हो?",
        "voice_id": "HyhAfYGa3UDZpjb4Ci4k"
      },
      {
        "text": "मैं काल हूँ, लोकों को उनके अंत तक ले जाने वाला। तुम्हारे बिना भी यहाँ खड़े ये योद्धा जीवित नहीं रहेंगे।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "उठो, अर्जुन। निमित्त बनो। ये योद्धा पहले ही उस अंत के भीतर खड़े हैं। अपने सामने के युद्ध का सामना करो।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "सामने की इस महानता को जाने बिना मैंने तुम्हें अपना मित्र कहा और सहज हँसी-मज़ाक में बातें कीं। जो मैं समझ न सका, उसके लिए मुझे क्षमा करो।",
        "voice_id": "HyhAfYGa3UDZpjb4Ci4k"
      },
      {
        "text": "मैं विस्मय से भरा हूँ और भय से काँप रहा हूँ। फिर वह रूप दिखाओ जिसे मैं सह सकूँ: मुकुट, गदा और चक्र से युक्त, चार भुजाओं वाला रूप।",
        "voice_id": "HyhAfYGa3UDZpjb4Ci4k"
      },
      {
        "text": "इस भय को शांत होने दो। तुमने जो रूप माँगा है, उसे फिर देखो।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "तुम्हारा सौम्य मानवीय रूप देखकर मैं फिर अपने आप को सँभाल पा रहा हूँ।",
        "voice_id": "HyhAfYGa3UDZpjb4Ci4k"
      },
      {
        "text": "अनन्य भक्ति से मुझे सचमुच जाना, देखा और मुझमें प्रवेश किया जा सकता है। मेरे लिए कर्म करो। मुझे अपना परम लक्ष्य बनाओ। आसक्ति और प्राणियों के प्रति वैर से मुक्त रहो।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      }
    ],

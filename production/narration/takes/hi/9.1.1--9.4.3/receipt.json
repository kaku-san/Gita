  "request": {
    "inputs": [
      {
        "text": "मैं तुम्हें गहरा ज्ञान बताऊँगा, उस समझ के साथ जिसे जीवन में उतारा जा सकता है। इसे खुले मन से सुनो।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "मेरी अव्यक्त उपस्थिति संसार में व्याप्त है। प्राणी मुझ पर निर्भर हैं, लेकिन मैं उनके भीतर सीमित नहीं हूँ। मेरी देखरेख में प्रकृति चल और अचल जगत को जन्म देती है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "कुछ लोग केवल मेरा मानवीय रूप देखते हैं और मेरे गहरे स्वरूप को नहीं पहचानते। दूसरे अटल भक्ति से मेरी ओर मुड़ते हैं, मेरा स्मरण और उपासना करते हैं।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "स्वर्ग के सुख भी समाप्त हो जाते हैं, जब उन्हें देने वाला पुण्य चुक जाता है। जिनका ध्यान पूरी तरह मुझमें टिका है, वे एक अलग लक्ष्य चाहते हैं। उस भक्ति-भरे जीवन को जो सहारा देता है, उसका मैं ध्यान रखता हूँ।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "एक पत्ता, एक फूल, फल या जल, भक्ति से अर्पित हो तो मैं उसे स्वीकार करता हूँ।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "तुम जो भी करो, जो भी खाओ, जो भी दो, जो भी साधना करो, वह मुझे अर्पित करो। कर्म को अर्पण बनने दो, ताकि तुम्हें बाँधने वाला उसका दावा छूट जाए।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "मैं सभी प्राणियों के प्रति समान हूँ। जो मुझसे प्रेम करते हैं, वे मुझमें रहते हैं, और मैं उनमें।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "जिसका आचरण बहुत गलत रहा हो, वह भी अनन्य भक्ति से मेरी ओर मुड़कर धर्म की ओर बढ़ सकता है। मेरा भक्त नष्ट नहीं होता।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "कृष्ण ऐसे आश्रय की बात करते हैं जो इस उपदेश में बताए गए सामाजिक विभाजनों के पार पहुँचता है। इसका निमंत्रण उन लोगों तक भी जाता है जिन्हें उस समय के समाज ने वंचित रखा था।",
        "voice_id": "JXjD3Apv5OBjfkhCa3tI"
      },
      {
        "text": "अपना मन मेरी ओर मोड़ो। मुझे अपनी भक्ति और आदर दो। मुझे अपना परम लक्ष्य बनाओ, और तुम मेरे पास आओगे।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      }
    ],

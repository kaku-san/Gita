  "request": {
    "inputs": [
      {
        "text": "निर्भयता, हृदय की शुद्धता, ज्ञान में स्थिरता, उदारता और आत्मसंयम, दैवी गुण हैं।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "सत्य बोलना, अहिंसा, क्रोध से मुक्ति, करुणा, कोमलता, विनम्रता और द्वेष से मुक्त होना भी दैवी गुण हैं।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "ये गुण मुक्ति की ओर ले जाते हैं। घमंड, अहंकार, क्रोध, कठोरता और अज्ञान बाँधते हैं। निराश मत हो, अर्जुन; तुम दैवी गुणों से युक्त हो।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "जब लोग क्या करना चाहिए और क्या नहीं, इसका विवेक छोड़ देते हैं, तब इच्छा ही उनका एकमात्र नियम बन सकती है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "वे सोचते हैं: मैंने यह पा लिया; और भी पाऊँगा। यह प्रतिद्वंद्वी हार गया; दूसरे को भी हराऊँगा। वे चिंता में उलझ जाते हैं, अनगिनत अपेक्षाओं से बँध जाते हैं और अन्यायपूर्ण साधनों से धन चाहते हैं।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "अपने बड़प्पन का भाव यज्ञ को भी दिखावा बना सकता है। कामना, क्रोध और लोभ, विनाश के तीन द्वार हैं। इन्हें छोड़ दो।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "इनसे मुक्त होकर मनुष्य अपने सच्चे कल्याण के लिए कर्म कर सकता है और परम लक्ष्य की ओर बढ़ सकता है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "जो उपदेश का मार्गदर्शन त्यागकर केवल इच्छा के अनुसार चलता है, वह न सिद्धि पाता है, न सुख, न परम लक्ष्य।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "क्या करना चाहिए और किससे बचना चाहिए, इसका विवेक उपदेश से दिशा पाए। उसे समझकर कर्म करो।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      }
    ],

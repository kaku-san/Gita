  "request": {
    "inputs": [
      {
        "text": "अपना मन मेरी ओर मोड़ो और मेरा आश्रय लेकर साधना करो। सुनो कि तुम मुझे और पूरी तरह कैसे जान सकते हो।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "पृथ्वी, जल, अग्नि, वायु, आकाश, मन, बुद्धि और “मैं” का भाव, मेरी अपरा प्रकृति के अंग हैं। इससे परे वह चेतन तत्व है जो संसार को धारण करता है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "सब कुछ मुझ पर टिका है, जैसे मोती एक धागे में पिरोए रहते हैं।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "मैं जल का स्वाद हूँ, सूर्य और चंद्रमा का प्रकाश हूँ, वेदों का पवित्र नाद हूँ। मैं धरती की सुगंध और जीवित प्राणियों का जीवन हूँ।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "मैं लालसा और आसक्ति से रहित बल हूँ। जिन गुणों से प्रकृति प्रकट होती है, वे मुझसे जन्मते हैं, लेकिन मेरा पूरा स्वरूप उनमें समाया नहीं है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "प्रकृति के गुणों में उलझकर लोग उनके पार जो है, उसे पहचान नहीं पाते। रूपों को प्रकट करने वाली इस शक्ति, माया, को पार करना कठिन है। जो मेरा आश्रय लेते हैं, वे इसे पार कर सकते हैं।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "लोग दुख में, ज्ञान की खोज में, लाभ की आशा में या ज्ञान के कारण मेरी ओर मुड़ते हैं। इस तरह मेरी ओर मुड़ना, हर रूप में मायने रखता है। ज्ञानी भक्त जानने लगता है कि सब कुछ ईश्वर पर टिका है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "इच्छा अक्सर उपासना को किसी खास फल की ओर मोड़ देती है। ऐसे फलों का अंत होता है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "अभी तुम्हें जो दिखाई देता है, मेरा सत्य केवल उतना ही नहीं है। राग और द्वेष समझ को ढक देते हैं। उनकी पकड़ से मुक्त होकर दृढ़ साधक मेरी ओर मुड़ते हैं और बुढ़ापे तथा मृत्यु से मुक्ति चाहते हैं।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      }
    ],

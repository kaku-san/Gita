  "request": {
    "inputs": [
      {
        "text": "प्रकृति और पुरुष, क्षेत्र और उसे जानने वाले को समझाओ। ज्ञान क्या है, और जानने योग्य क्या है?",
        "voice_id": "HyhAfYGa3UDZpjb4Ci4k"
      },
      {
        "text": "इस शरीर को क्षेत्र कहा जाता है। जो इसे जानता है, वह क्षेत्रज्ञ है। मुझे भी सभी क्षेत्रों में क्षेत्रज्ञ जानो।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "शरीर, इंद्रियाँ, मन, इच्छा, द्वेष, सुख और दुख, बदलते हुए क्षेत्र के अंग हैं। क्षेत्र और उसके ज्ञाता का भेद समझना ज्ञान का मुख्य आधार है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "विनम्रता, सच्चाई, अहिंसा, धैर्य, आत्मसंयम, स्थिरता और गुरु की सेवा, ज्ञान के अंग हैं।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "जन्म, बुढ़ापे, बीमारी और मृत्यु पर विचार; ममत्व से मुक्ति; भक्ति; और आत्मा की निरंतर खोज भी ज्ञान के अंग हैं। ये उस व्यक्ति को गढ़ते हैं जो समझना चाहता है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "उस जानने योग्य के बारे में सुनो, जिसे जानकर मनुष्य अमरत्व पाता है: अनादि, परम ब्रह्म, जो होने और न होने के सामान्य भेद से परे है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "वह प्राणियों के भीतर भी है और बाहर भी, चल भी है और अचल भी, पास भी है और दूर भी। अविभाजित होकर भी वह अलग-अलग रूपों में दिखाई देता है। वह प्रकाशों का प्रकाश है, हृदय में उपस्थित है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "प्रकृति बदलते हुए साधनों और कर्मों को जन्म देती है। चेतन तत्व सुख और दुख का अनुभव करता है; प्रकृति के गुणों से आसक्ति उसे शरीर के बंधन में रखती है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "कुछ ध्यान से समझ की ओर बढ़ते हैं, कुछ ज्ञान से, कुछ कर्म से, और दूसरे सुनकर तथा सुनी हुई बात का अभ्यास करके।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "प्राणियों में परम उपस्थिति को समान रूप से देखो, जो नष्ट होने वालों के बीच भी बनी रहती है। क्षेत्र और उसके ज्ञाता का भेद, और बंधन से परे जाने का मार्ग पहचानना सीखो।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      }
    ],

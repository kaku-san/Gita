  "request": {
    "inputs": [
      {
        "text": "प्रकृति के तीन गुण अविनाशी आत्मा को शरीरधारी जीवन से बाँधते हैं। ये हैं सत्त्व, रजस् और तमस्।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "सत्त्व प्रकाश और स्पष्टता लाता है, फिर भी सुख और ज्ञान की आसक्ति से बाँधता है। रजस् लालसा और बेचैन सक्रियता लाता है, और कर्म के माध्यम से बाँधता है। तमस् लापरवाही, जड़ता और नींद से समझ को ढक देता है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "गुण एक-दूसरे के संबंध में प्रबल होते और घटते हैं। स्पष्टता सत्त्व का संकेत है; लोभ और निरंतर दौड़-धूप रजस् का; भ्रम और उपेक्षा तमस् के संकेत हैं।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "उनका प्रभाव आचरण और उसके परिणामों को आकार देता है, आगे के जन्मों की गति को भी। पहचानना सीखो कि तुम्हारे भीतर क्या प्रबल हो रहा है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "जो इन गुणों से परे चला गया हो, वह कैसा व्यवहार करता है? वह इन्हें कैसे पार कर सकता है?",
        "voice_id": "HyhAfYGa3UDZpjb4Ci4k"
      },
      {
        "text": "ऐसा व्यक्ति स्पष्टता, सक्रियता या भ्रम के आने पर उनसे द्वेष नहीं करता, और उनके चले जाने पर उन्हें पाने की लालसा भी नहीं करता। वह गुणों को काम करते हुए पहचानता है और स्थिर रहता है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "वह सुख-दुख, प्रशंसा-निंदा, मित्रता-वैर या हर काम को अहंकार की संपत्ति बना लेने की आवश्यकता से कम बँधा होता है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "जो अडिग भक्ति से मेरी सेवा करता है, वह तीनों गुणों से पार होकर ब्रह्म को पाने के योग्य बनता है।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      },
      {
        "text": "मैं अविनाशी ब्रह्म का, अमरत्व का, सनातन धर्म का और पूर्ण सुख का आधार हूँ।",
        "voice_id": "hRHid0k1FJN4S80Kbs5m"
      }
    ],
